# PLANTILLA - no pongas valores reales aqui. Este fichero SI se sube a git.
# Los valores reales van en variables de entorno (ver README.md).

BIWENGER_TOKEN=
BIWENGER_LEAGUE=
BIWENGER_USER=

# Opcionales
BIWENGER_COMPETITION=la-liga
BIWENGER_LANG=es
BIWENGER_SCORE=1

# Build del frontend de Biwenger. Si la API responde 400 "Old version",
# recaptura x-version de DevTools y ponlo aqui. Por defecto: 631
BIWENGER_VERSION=

# --- Correo (Fase 3) -------------------------------------------------------
# La contrasena tiene que ser una CONTRASENA DE APLICACION de Google,
# nunca la de tu cuenta. Se aceptan los espacios que muestra Gmail.
BIWENGER_MAIL_FROM=
BIWENGER_MAIL_PASSWORD=
BIWENGER_MAIL_TO=

# Opcionales. 465 = SSL directo (por defecto), 587 = STARTTLS
BIWENGER_MAIL_HOST=smtp.gmail.com
BIWENGER_MAIL_PORT=465
